# ===== Template konfigurasi =====
# Salin file ini menjadi .env lalu isi nilai asli. JANGAN commit .env.

# Spreadsheet ID Google Sheets (lihat dari URL spreadsheet)
GDT_SPREADSHEET_ID=
STOCK_SPREADSHEET_ID=

# URL Web App Apps Script (berakhir /exec) untuk menulis ke sheet LOG
LOG_WEBAPP_URL=

# Password admin untuk membuka dashboard log
ADMIN_PASSWORD=
